{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Policy definition",
  "description": "A standing rule the player sets. See spec/05-policy-system.md. Reference example for all other content schemas.",
  "type": "object",
  "required": ["schema_version", "id", "category", "name_key", "options", "effect_lag_hours", "cooldown_days"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Stable identifier. Never derived from array position."
    },
    "category": {
      "enum": ["operating_hours", "slots", "pricing", "security", "labour",
               "environmental", "service_standards", "commercial", "contingency"]
    },
    "name_key": { "type": "string", "description": "Localisation key, never a literal" },
    "description_key": { "type": "string" },
    "requires_approval_from": {
      "enum": ["none", "regulator", "community_council", "airline_consortium"],
      "default": "none"
    },
    "approval_weeks_min": { "type": "integer", "minimum": 0 },
    "approval_weeks_max": { "type": "integer", "minimum": 0 },
    "effect_lag_hours": {
      "type": "integer", "minimum": 0, "maximum": 168,
      "description": "Nothing is instant. 24h to 7 days by category."
    },
    "cooldown_days": { "type": "integer", "minimum": 0 },
    "unlocked_at_tier": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label_key", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label_key": { "type": "string" },
          "parameters": {
            "type": "array",
            "description": "Player-set numbers, e.g. curfew start/end, declared capacity per hour",
            "items": {
              "type": "object",
              "required": ["id", "label_key", "min", "max", "default"],
              "properties": {
                "id": { "type": "string" },
                "label_key": { "type": "string" },
                "min": { "type": "string", "description": "Fixed-point decimal string. No floats in sim content." },
                "max": { "type": "string" },
                "default": { "type": "string" },
                "step": { "type": "string" }
              }
            }
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "magnitude"],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "enum": ["reputation_passenger", "reputation_airline",
                           "reputation_regulator", "reputation_community",
                           "revenue_aeronautical", "revenue_commercial",
                           "operating_cost", "security_throughput",
                           "breach_probability", "movement_capacity",
                           "dwell_time", "staff_morale", "strike_probability"]
                },
                "magnitude": { "type": "string", "description": "Fixed-point decimal string, per day unless stated" },
                "scales_with_parameter": { "type": "string" },
                "condition": { "type": "string", "description": "Optional expression id defined in spec" }
              }
            }
          }
        }
      }
    },
    "exemption_rules_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Player may author exemptions, e.g. medical, diversion, delayed-inbound grace window"
    }
  }
}
