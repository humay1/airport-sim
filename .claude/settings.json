{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PONYTAIL_SUBAGENT_MATCHER": "^(general-purpose|Plan|claude)$"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(rm -rf /*)",
      "Agent(Explore)",
      "Agent(agent-skills:code-reviewer)",
      "Agent(agent-skills:test-engineer)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./ci/hooks/guard-paths.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./ci/hooks/on-subagent-stop.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": { "superpowers@claude-plugins-official": false },
  "$comment": "Layer 3 of the path guards. Layer 1 (branch protection + CODEOWNERS) is the one that actually holds; this one tells the agent in-turn instead of ten minutes later in CI."
}
