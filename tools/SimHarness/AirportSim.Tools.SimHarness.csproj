<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AirportSim.Tools.SimHarness</AssemblyName>
    <RootNamespace>AirportSim.Tools.SimHarness</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/sim/core/AirportSim.Sim.Core.csproj" />
    <ProjectReference Include="../../src/sim/world/AirportSim.Sim.World.csproj" />
    <ProjectReference Include="../../src/sim/schedule/AirportSim.Sim.Schedule.csproj" />
    <ProjectReference Include="../../src/sim/flow/AirportSim.Sim.Flow.csproj" />
  </ItemGroup>

</Project>
