{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "looks.schema.json",
  "title": "Render looks",
  "description": "Airline liveries and the passenger clothing palette for the scene layer. See spec/15-interfaces-render.md section 15.16. Not sim content: the content loader ignores data/looks/. Colours are sRGB, upper-case hexadecimal.",
  "type": "object",
  "required": ["schema_version", "id", "default_livery", "liveries", "passengers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "const": "looks" },
    "default_livery": { "$ref": "#/$defs/livery" },
    "liveries": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z0-9]{1,8}$" },
      "additionalProperties": { "$ref": "#/$defs/livery" }
    },
    "passengers": {
      "type": "object",
      "required": ["tops", "bottoms", "skins", "hairs", "bags"],
      "additionalProperties": false,
      "properties": {
        "tops": { "$ref": "#/$defs/palette" },
        "bottoms": { "$ref": "#/$defs/palette" },
        "skins": { "$ref": "#/$defs/palette" },
        "hairs": { "$ref": "#/$defs/palette" },
        "bags": { "$ref": "#/$defs/palette" }
      }
    }
  },
  "$defs": {
    "colour": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/colour" }
    },
    "livery": {
      "type": "object",
      "required": ["fuselage", "tail", "cheatline", "engines", "logo", "mark"],
      "additionalProperties": false,
      "properties": {
        "fuselage": { "$ref": "#/$defs/colour" },
        "tail": { "$ref": "#/$defs/colour" },
        "cheatline": { "$ref": "#/$defs/colour" },
        "engines": { "$ref": "#/$defs/colour" },
        "logo": { "$ref": "#/$defs/colour" },
        "mark": { "enum": ["none", "disc", "ring", "chevron", "star", "bars", "diamond", "crescent"] }
      }
    }
  }
}
