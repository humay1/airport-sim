    <ProjectReference Include="../../sim/airside/AirportSim.Sim.Airside.csproj" />
    <ProjectReference Include="../../sim/flow/AirportSim.Sim.Flow.csproj" />
    <ProjectReference Include="../../sim/turnaround/AirportSim.Sim.Turnaround.csproj" />
    <ProjectReference Include="../../sim/delay/AirportSim.Sim.Delay.csproj" />
    <ProjectReference Include="../render/Scene/AirportSim.App.Render.csproj" />
    <ProjectReference Include="../ui/Scene/AirportSim.App.Ui.csproj" />
  </ItemGroup>

</Project>
